# Copy this file to .env (optional - the app also runs without one using safe defaults).

# Secret used to sign login tokens - use any long random string
JWT_SECRET=change-this-to-a-long-random-string

# The built-in admin login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Port the server listens on
PORT=4000

# Optional: where the local database file lives (default: ./data/cryptoguard.db)
# DB_PATH=./data/cryptoguard.db
